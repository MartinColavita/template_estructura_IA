#!/usr/bin/env bash
# Hook pre-commit del repositorio del Cerebro — bloquea el commit si lo que entra al commit deja algun espejo de
# skills distinto de su fuente cerebro-digital/configuracion-ia/skills/, o si algo de lo que entra trae BOM o
# caracteres de control, o si una skill sale de la especificacion (o los conteos que la anuncian no cierran).
#   .agents/skills/  -> lo lee Antigravity (y opencode lo auto-descubre)
#   .claude/skills/  -> lo lee Claude Code (skills project-scoped, nativas)
#
# Activar UNA vez por dev (los hooks NO viajan activados en el clone):
#   git config core.hooksPath .githooks
#
# Es una verificacion (no modifica). Mira LO QUE ENTRA AL COMMIT (el arbol del indice), no el disco: un cambio sin
# 'git add' en otra parte no frena este commit, y un espejo que no se agrego si lo frena. .gitattributes (eol=lf)
# hace que la comparacion sea la misma en Windows, Linux y mac.
#
# Shebang BASH (no sh) a proposito: el hook esta escrito y probado en bash (bin/probar-hook.py).
# Falla CERRADO si se lo corre con otro shell (p. ej. "sh pre-commit"): un shell distinto puede
# interpretar algo de otra forma y dejar pasar el commit diciendo que esta todo bien.
if [ -z "${BASH_VERSION:-}" ]; then
  echo "pre-commit BLOQUEADO: este hook necesita bash (esta escrito y probado en bash)."
  echo "  Se ejecuto con un shell que no lo soporta, asi que NO pudo verificar nada."
  echo "  Corrilo con bash, o dejá que git lo invoque por su shebang (#!/usr/bin/env bash)."
  exit 1
fi

ROOT="$(git rev-parse --show-toplevel)"
SRC_REL="cerebro-digital/configuracion-ia/skills"
AGENTS_SRC="$ROOT/cerebro-digital/configuracion-ia/agentes"

# El arbol que va a entrar al commit, una sola vez. Sin el no se puede decir nada: falla cerrado.
ARBOL="$(git write-tree 2>/dev/null)"
if [ -z "$ARBOL" ]; then
  echo "pre-commit BLOQUEADO: git write-tree fallo: no puedo ver que entra al commit."
  exit 1
fi
en_commit() { git rev-parse -q --verify "$ARBOL:$1" 2>/dev/null; }

# check_mirror FUENTE ESPEJO (rutas relativas al repo): el espejo versionado entra al commit igual a la fuente.
check_mirror() {
  F="$(en_commit "$1")"
  E="$(en_commit "$2")"
  if [ -z "$E" ]; then
    echo "pre-commit BLOQUEADO: falta el espejo $2/ en lo que entra al commit (la fuente $1/ si esta)."
    echo "  Corre:  bin/sync-skills.sh (o .ps1)   y despues:  git add $2"
    return 1
  fi
  if [ "$F" != "$E" ]; then
    echo "pre-commit BLOQUEADO: en lo que entra al commit, el espejo $2/ no es igual a la fuente $1/:"
    git diff-tree -r --name-status "$F" "$E" 2>/dev/null | head -10 | sed 's/^/    /'
    echo "  Corre:  bin/sync-skills.sh (o .ps1)   y despues:  git add $1 $2"
    return 1
  fi
  return 0
}

# Espejos gemelos de los repos de codigo (back/ y front/): no hay fuente canonica, son dos copias y ninguna manda
# todavia (decision abierta, ver doctor/README.md). Lo unico exigible es que entren iguales al commit.
check_pair() {
  A="$(en_commit "$1")"
  B="$(en_commit "$2")"
  if [ -z "$A" ] && [ -z "$B" ]; then
    return 0   # ese lado todavia no arranco
  fi
  if [ "$A" != "$B" ]; then
    echo "pre-commit BLOQUEADO: $1/ y $2/ no entran iguales al commit. Son copias gemelas: todo cambio va en las DOS."
    return 1
  fi
  return 0
}

# Los espejos de agentes no se versionan: no entran al commit, asi que no lo frenan. Si estan viejos, la herramienta
# lee el agente viejo: se avisa.
aviso_agentes() {
  for REL in .agents/agents .claude/agents; do
    if [ ! -d "$ROOT/$REL" ] || ! git diff --no-index --ignore-cr-at-eol --quiet "$AGENTS_SRC" "$ROOT/$REL" 2>/dev/null; then
      echo "pre-commit AVISO (no frena): el espejo $REL/ falta o no coincide con la fuente de agentes; corre  bin/sync-agents.sh (o .ps1)."
    fi
  done
}

# Python 3 para las guardas que son scripts. Falla CERRADO: sin Python no se dice OK sobre nada. Se busca una vez.
PY=""
buscar_python() {
  [ -n "$PY" ] && return 0
  for c in python3 python py; do
    if command -v "$c" >/dev/null 2>&1 && "$c" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 7) else 1)' >/dev/null 2>&1; then
      PY="$c"; return 0
    fi
  done
  return 1
}

# Guarda de caracteres de control invisibles (BEL 0x07, BS 0x08, VT 0x0B, FF 0x0C) y de BOM UTF-8, sobre lo que esta
# en stage. La hace bin/verificar-staged.py, en un solo proceso; el CI corre lo mismo con --todo.
check_control_chars() {
  if ! buscar_python; then
    echo "pre-commit BLOQUEADO: no encontre Python 3 para correr bin/verificar-staged.py (BOM y caracteres de control)."
    return 1
  fi
  "$PY" -I "$ROOT/bin/verificar-staged.py" --repo "$ROOT" > "$TMPD/staged.txt" 2>&1
  RC=$?
  if [ "$RC" = "0" ]; then
    return 0
  fi
  echo "pre-commit BLOQUEADO (guarda de encoding):"
  cat "$TMPD/staged.txt"
  return 1
}

# Guarda de ESPECIFICACION de skills, y de los conteos y listas que las anuncian (AGENTS.md, README.md,
# INSTALACION.md, cerebro-digital/index.md). Lo cuenta bin/verificar-skills.py, en un proceso: los patrones viven ahi.
# Corre sobre una copia de lo que entra al commit (el indice), no sobre el disco: una skill a medio hacer sin
# 'git add' no frena el commit de otra cosa, y un conteo corregido solo en el disco no deja pasar uno roto.
# Falla CERRADO si no hay Python 3: nunca decir OK sobre algo que no se pudo mirar.
check_skills_spec() {
  if ! buscar_python; then
    echo "pre-commit BLOQUEADO: no encontre Python 3 para correr bin/verificar-skills.py."
    echo "  Sin eso no puedo verificar la especificacion de las skills (el ecosistema necesita Python 3 igual)."
    return 1
  fi
  if [ ! -f "$ROOT/bin/verificar-skills.py" ]; then
    echo "pre-commit BLOQUEADO: falta bin/verificar-skills.py (restauralo desde el template)."
    return 1
  fi
  # El codigo se toma ANTES de cualquier if: despues de un "if ...; fi" sin rama, $? vale 0 y el 2 no se veia nunca.
  IDX="$TMPD/indice"
  mkdir -p "$IDX"
  # solo los .md: es lo unico que lee (SKILL.md y references/); el resto de una skill vendida pesa y no se mira
  git ls-files -z -- "$SRC_REL/*.md" ".claude/skills/*.md" ".agents/skills/*.md" "back/.claude/skills/*.md" \
    "back/.agents/skills/*.md" "front/.claude/skills/*.md" "front/.agents/skills/*.md" AGENTS.md README.md \
    INSTALACION.md cerebro-digital/index.md |
    git checkout-index -z --stdin --prefix="$IDX/" 2>/dev/null
  "$PY" -I "$ROOT/bin/verificar-skills.py" "$IDX" > "$TMPD/skills.txt" 2>&1
  RC=$?
  if [ "$RC" = "0" ]; then
    return 0
  fi
  if [ "$RC" = "2" ]; then
    # 2 es SIN DATOS: tambien lo que devuelve el script cuando explota. Aca la fuente de skills existe, asi que no es
    # "no hay skills": no se pudo verificar, y eso no es OK.
    echo "pre-commit BLOQUEADO: verificar-skills no pudo verificar la especificacion de las skills (SIN DATOS):"
    cat "$TMPD/skills.txt"
    return 1
  fi
  echo "pre-commit BLOQUEADO: hay skills fuera de la especificacion de Agent Skills, o un conteo que no cierra:"
  grep -E '^  (HALLAZGO|AVISO)' "$TMPD/skills.txt" || cat "$TMPD/skills.txt"
  echo "  Corregilos (name == carpeta, description de hasta 1024 caracteres, el numero y la lista al dia) y volve a commitear."
  return 1
}

# Temporal propio, borrado siempre (incluso si el hook corta por una senal).
TMPD="$(mktemp -d)" || exit 1
trap 'rm -rf "$TMPD"' EXIT HUP INT TERM

FALLO=0

# Los espejos de la raiz solo se verifican si la fuente entra al commit.
if [ -n "$(en_commit "$SRC_REL")" ]; then
  check_mirror "$SRC_REL" ".agents/skills" || FALLO=1
  check_mirror "$SRC_REL" ".claude/skills" || FALLO=1
  check_skills_spec || FALLO=1
fi

if [ -d "$AGENTS_SRC" ]; then
  aviso_agentes
fi

# Los gemelos de back/front se auto-saltean si no existe ninguno de los dos lados.
check_pair "back/.claude/skills" "back/.agents/skills" || FALLO=1
check_pair "front/.claude/skills" "front/.agents/skills" || FALLO=1

# La guarda de encoding corre SIEMPRE: no depende de las skills.
check_control_chars || FALLO=1

exit $FALLO
